# Copy this file to .env and fill it in. .env is gitignored — never commit it.

# Gemini API key. Get one at https://aistudio.google.com/apikey
# Leave blank to run the scripted fallback interview instead (works offline).
   GEMINI_API_KEY=
   GEMINI_MODEL=gemini-3.5-flash-lite

# Sign tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Origins allowed to call this API, comma-separated.
# In production set this to your GitHub Pages URL, e.g.
# ALLOWED_ORIGINS=https://your-username.github.io
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Scoring weights (slide 9). Must add up to 1.0.
INTEREST_WEIGHT=0.70
ACADEMIC_WEIGHT=0.30

FLASK_DEBUG=false
PORT=5000
